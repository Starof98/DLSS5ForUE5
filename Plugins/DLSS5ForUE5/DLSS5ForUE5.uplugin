    "SupportedTargetPlatforms": [
        "Win64"
    ],
    "Modules": [
        {
            "Name": "DLSS5ForUE5_nvngx",
            "Type": "Runtime",
            "LoadingPhase": "PostConfigInit"
        },
        {
            "Name": "DLSS5ForUE5Editor",
            "Type": "Editor",
            "LoadingPhase": "PostEngineInit"
        }
    ],
    "EnabledByDefault": true,
    "CreatedByURL": "https://github.com/praveenkumarappu",
